# 复制本文件为 .env 后，设置仅用于本机开发的密码。
MYSQL_DATABASE=marine_ebook
MYSQL_USER=marine_ebook
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3307

# Sa-Token JWT 签名密钥：请为本机生成至少 32 个随机字符，不能提交真实值。
SA_TOKEN_JWT_SECRET_KEY=replace-with-a-local-random-secret-of-at-least-32-characters
