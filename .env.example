# 复制本文件为 .env 后，设置仅用于本机开发的密码。
MYSQL_DATABASE=marine_ebook
MYSQL_USER=marine_ebook
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3307

# Redis 用于 Sa-Token 登录会话与后续阅读/点赞防重。
REDIS_HOST=localhost
REDIS_PORT=6379

# 仅首次创建总管理员时读取；生产环境请使用强密码，不能提交真实值。
INITIAL_SUPER_ADMIN_USERNAME=admin
INITIAL_SUPER_ADMIN_PASSWORD=change-this-local-admin-password
